{
  "name": "vrgeorgia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "node --import ./src/env-bootstrap.js --watch src/server.js",
    "build:tour-ui": "npm install --include=dev --prefix ../tour-builder && npm run build --prefix ../tour-builder",
    "build": "npm run build:tour-ui",
    "start": "node --import ./src/env-bootstrap.js src/server.js",
    "seed": "node --import ./src/env-bootstrap.js src/seed.js"
  },
  "dependencies": {
    "@google-cloud/translate": "^8.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.0.7",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  }
}

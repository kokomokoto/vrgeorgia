# ლოკალური dev (tour-builder ცალკე :3002 → API :5000)
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Publish-ისას საჯარო ბმული (production: იგივე API ჰოსტი)
NEXT_PUBLIC_TOUR_BUILDER_PUBLIC_URL=https://vrgeorgia-api.onrender.com

# Remote panoramas: იგივე R2 env რაც backend (.env)
# MEDIA_PROVIDER=r2 + CF_ACCOUNT_ID + R2_* + R2_PUBLIC_BASE_URL
# Cloudinary keys აღარ არის საჭირო ახალი upload-ებისთვის.

# production-ში UI იგივე სერვისზეა რაც API (backend npm run build აგებს tour-builder-ს).
# ცალკე Render სერვისისთვის: TOUR_UI_STANDALONE=1 npm run build:standalone

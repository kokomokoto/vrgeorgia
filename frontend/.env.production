NEXT_PUBLIC_API_BASE=https://vrgeorgia-api.onrender.com

# Canonical public site (apex, no www)
NEXT_PUBLIC_SITE_URL=https://vhome.ge

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty = analytics disabled.
# Set the real value in the Render dashboard env (NEXT_PUBLIC_GA_ID) — it is inlined at build time.
NEXT_PUBLIC_GA_ID=

# 3D ტურის builder (Render service — არა localhost)
NEXT_PUBLIC_TOUR_BUILDER_URL=https://vrgeorgia-api.onrender.com

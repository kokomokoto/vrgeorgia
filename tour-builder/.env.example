# MongoDB — ტურების/სცენების/hotspot-ების მონაცემები ინახება Mongo-ში
# (იგივე ბაზა, რასაც მთავარი საიტი იყენებს). კოლექციები: tb_tours, tb_scenes, tb_hotspots.
# Render.com-ზე იგივე connection string მიუთითე, რაც backend service-ს აქვს.
MONGODB_URI=

# VR Georgia-ში publish-ისას ეს URL იგზავნება (არა localhost)
NEXT_PUBLIC_TOUR_BUILDER_PUBLIC_URL=https://vrgeorgia-tour-builder.onrender.com

# Cloudinary — 3D ტურის პანორამები ამ ანგარიშზე აიტვირთება
# (იგივე მნიშვნელობები, რასაც მთავარი backend იყენებს)
# Render.com-ზე ეს ცვლადები დააყენე service-ის Environment-ში.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# შენიშვნა: თუ ეს ცვლადები ცარიელია (მაგ. ლოკალურ დეველოპმენტში),
# ფოტოები ლოკალურ დისკზე შეინახება data/uploads/-ში.

# ტურების მონაცემთა ბაზის (SQLite) საქაღალდე.
# Render-ზე persistent disk-ის mount path მიუთითე, რომ deploy-ებს შორის
# ტურები არ წაიშალოს. მაგ: /var/data
# TOUR_DATA_DIR=/var/data

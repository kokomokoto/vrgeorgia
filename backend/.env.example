# ======================================
# VR Georgia Backend — Environment Variables
# ======================================
# ლოკალურად: cp .env.example .env
# პროდაქშენზე: Render.com → Environment tab

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# ლოკალური:
MONGODB_URI=mongodb://127.0.0.1:27017/vrgeorgia
# პროდაქშენი (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/vrgeorgia?retryWrites=true&w=majority

# JWT (პროდაქშენზე აუცილებლად შეცვალე!)
JWT_SECRET=change_me_to_a_long_random_string_min_64_chars
JWT_EXPIRES_IN=30d

# CORS — ნებადართული ფრონტენდ დომენები
# ლოკალურად არ არის საჭირო (dev-ზე ყველა დაშვებულია)
# Production:
# ALLOWED_ORIGINS=https://vrgeorgia.ge,https://www.vrgeorgia.ge,https://vhome.ge,https://www.vhome.ge
# Staging API (Render free) — staging ფრონტის დომენი:
# ALLOWED_ORIGINS=https://staging.vrgeorgia.ge,https://vrgeorgia-web-staging.onrender.com

# 3D ტური — საჯარო URL (იგივე, რაც frontend NEXT_PUBLIC_TOUR_BUILDER_URL)
# TOUR_BUILDER_PUBLIC_URL=https://vrgeorgia-api.onrender.com
# Staging:
# TOUR_BUILDER_PUBLIC_URL=https://vrgeorgia-api-staging.onrender.com
# API_PUBLIC_URL=https://vrgeorgia-api-staging.onrender.com

# ფოტოების მაქს. ზომა თითო ფაილზე სერვერზე (MB) — შემდეგ sharp-ით იკუმშება Cloudinary ~10MB-მდე
PROPERTY_PHOTO_MAX_MB=50

# Optional: fixed USD→GEL rate for price search (otherwise live API + 2.75 fallback)
# USD_TO_GEL_RATE=2.75

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
